Algoritmo "salariomes"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas Santos
// Descrição   : Calcula e mostra o salário referido do mês com base nas-
// horas trabalhadas  o número de horas trabalhadas no mês
// Autor(a)    : Nome do(a) aluno(a)
// Data atual  : 31/08/2026
Var
hora:real
horaMes:real
salario:real

Inicio
escreval("Quanto você ganha por hora? (salário por hora): ")
leia(Hora)
escreval("E o número de horas trabalhadas no mês?: ")
leia(horaMes)
salario<-hora*horaMes
escreva("O seu salário é: ", salario)


Fimalgoritmo