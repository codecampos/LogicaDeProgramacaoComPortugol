Algoritmo "circulo06"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos
// Descrição   : Calcula a área de um círculo usando PI e o raio.
// Autor(a)    : Miguel Santos Campos
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
pix:real
raio: real
area: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Programa para calcular área do circulo")
escreval("Digite o PI(3,14) :")
leia(pix)
escreval("Digite o raio :")
raio<-raio*raio
leia(raio)
area<-(raio*raio)*pix
escreval("A área do circulo é : ", area)

Fimalgoritmo