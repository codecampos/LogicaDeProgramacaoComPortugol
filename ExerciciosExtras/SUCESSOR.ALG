Algoritmo "Sucessor"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos
// Descrição   : Escreva um algoritmo para ler um valor
// (do teclado) e escrever (na tela) o seu sucessor.
// Autor(a)    : Miguel Santos Campos
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
numero: inteiro
sucessor: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
Escreval("Programa de Sucessor")
escreval("Digite um número :")
leia(numero)
sucessor<-numero +1
escreval("O sucessor do número digitado é : ", sucessor)

Fimalgoritmo