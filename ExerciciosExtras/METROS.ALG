Algoritmo "Metros"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas Santos
// Descrição   : Converte metros para centimetros
// Autor(a)    : Miguel Santos Campos
// Data atual  : 31/08/2026
Var
metros:real

Inicio
Escreval("Escreva a altura em metros (m) :")
leia(metros)
metros<-metros*100
Escreva("Sua altura em centimetros é:",metros)

Fimalgoritmo