Algoritmo "salario"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas Santos
// Descrição   : Percentual de reajuste do salário
// Autor(a)    : Miguel Santos Campos
// Data atual  : 31/08/2026
Var
salario:real
reajuste:real
percentual:real

Inicio
Escreval("Digite o salário mensal para reajuste: ")
leia(salario)
Escreval("Digite o percentual de reajuste: ")
leia(reajuste)
percentual<-(salario*reajuste)/100
escreva("O valor do reajuste é: ", percentual)


Fimalgoritmo