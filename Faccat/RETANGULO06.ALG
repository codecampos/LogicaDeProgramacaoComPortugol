Algoritmo "retangulo06"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos
// Descrição   : Inserir base e altura do retângulo para calcular a área
// Autor(a)    : Miguel Santos Campos
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
base: real
altura: real
area: real

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Programa para calcular área do retângulo")
escreval("Digite a base :")
leia(base)
escreval("Digite a altura :")
leia(altura)
area<-base*altura
escreval("A área do retângulo é : ", area)

Fimalgoritmo