Algoritmo "multiplicação"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costa dos Santos
// Descrição   : Solicitar dois números, multiplicar e exibir resultado
// Autor(a)    : Miguel Santos Campos
// Data atual  : 28/08/2026
Var
// Seção de Declarações das variáveis 
numero01: inteiro
numero02: inteiro
multiplicacao: inteiro

Inicio
// Seção de Comandos, procedimento, funções, operadores, etc... 
escreval("Programa de Multiplicação")
escreva("Digite o 1 número :")
leia(numero01)
escreva("Digite o 2 número :")
leia(numero02)
multiplicacao<-numero01*numero02
escreva("A multiplicação dos números digitados é :", multiplicacao)


Fimalgoritmo