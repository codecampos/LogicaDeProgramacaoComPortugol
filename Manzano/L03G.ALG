Algoritmo "L03G"
// Disciplina  : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos
// Descrição   : Escreva um programa que apresente a série de
// Fibonacci até o décimo quinto termo
// Autor(a)    : Miguel Santos Campos
// Data atual  : 16/09/2026
Var
   // Seção de Declarações das variáveis
   primeiroNumero, segundoNumero, contador, resultado: inteiro

Inicio
   // Seção de Comandos, procedimento, funções, operadores, etc...
   contador<-1
   resultado<-1
   escreval("Programa que mostra a série de Fibonacci até 15")
   enquanto contador < 16 faca
      resultado<-resultado+primeiroNumero
      primeiroNumero<-segundoNumero
      segundoNumero<-resultado
      escreval(resultado)
      contador<-contador+1
   fimenquanto


Fimalgoritmo