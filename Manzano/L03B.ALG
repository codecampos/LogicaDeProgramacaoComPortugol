Algoritmo "L03B"
// Disciplina   : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos 
// Descrição   : Apresentar o total da soma obtida dos cem primeiros
// números inteiros (1+2+3+4+...+98+99+100).
// Autor(a)    : Miguel Santos Campos
// Data atual  : 12/09/2026
Var
contador:inteiro
resultado:inteiro

Inicio
Escreval("Programa para ver soma dos cem primeiros números: ")
contador<-1
enquanto contador<101 faca
resultado<-contador+resultado
contador<-contador+1
Escreval(resultado)
fimenquanto

Fimalgoritmo