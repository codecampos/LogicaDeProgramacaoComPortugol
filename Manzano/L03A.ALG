Algoritmo "L03A"
// Disciplina  : [Lógica de Programação com JavaScript]
// Professor   : Jailson Costas dos Santos 
// Descrição   : Apresentar os resultados de uma tabuada
// de multiplicar (de 1 até 10) de um número qualque
// Autor(a)    : Miguel Santos Campos
// Data atual  : 12/09/2026
Var
numero: inteiro
contador: inteiro
resultado: inteiro

Inicio
Escreval("Programa para mostrar tabuada de multiplicação")
Escreval("Digite o número para saber sua tabuada do um ao dez")
leia(numero)
contador<-1
enquanto contador <=10 faca
resultado<-numero*contador
Escreval("O resultado foi: ", resultado)
contador<-contador+1

fimenquanto
Fimalgoritmo
