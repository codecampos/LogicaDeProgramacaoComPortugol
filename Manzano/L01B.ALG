Algoritmo " L01C"
// Disciplina  : [Lógica de Programação com Javascript]
// Professor   : Jailson Costas Santos
// Descrição   : Calcular e apresentar o valor do volume de uma lata de
// óleo
// Autor(a)    : Miguel Santos Campos
// Data atual  : 31/08/2026
Var
pi:real
altura:real
volume:real

Inicio
Escreval("Qual o valor do raio da lata de óleo: ")
leia(pi)
volume<-pi*altura
Escreva("O volume da lata é: ", volume )

Fimalgoritmo